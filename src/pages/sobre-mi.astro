---
import Layout from '../layouts/Layout.astro';
import Ticker from '../components/Ticker.astro';
import { ArrowLeft, GraduationCap, MapPin, Calendar } from 'lucide-react';
import { profile } from '../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = new URL(`${base}/`, Astro.site).toString();
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

// JSON-LD: AboutPage + ProfilePage + BreadcrumbList. La página hereda la
// entidad Person (@id home#person) ya definida en el @graph del Layout.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${pageUrl}#webpage-about`,
      url: pageUrl,
      name: `Sobre mí — ${profile.shortName}`,
      description: profile.blurbEs,
      inLanguage: 'es',
      isPartOf: { '@id': `${homeUrl}#website` },
      about: { '@id': `${homeUrl}#person` },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${pageUrl}#profilepage`,
      url: pageUrl,
      inLanguage: 'es',
      mainEntity: { '@id': `${homeUrl}#person` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: homeUrl },
        { '@type': 'ListItem', position: 2, name: 'Sobre mí', item: pageUrl },
      ],
    },
  ],
};
---

<Layout
  title={`Sobre mí — ${profile.shortName}`}
  description={profile.blurbEs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main id="main" class="mx-auto max-w-4xl px-6 py-32 xl:max-w-5xl">
    <nav aria-label="Migas de pan" class="reveal-item is-visible mb-6">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-(--color-muted)">
        <li><a href={`${base}/`} class="hover:text-(--color-accent)">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-(--color-fg)" aria-current="page">Sobre mí</li>
      </ol>
    </nav>

    <h1 class="reveal-item is-visible font-display text-3xl font-bold tracking-tight text-(--color-fg) sm:text-4xl xl:text-5xl">
      Sobre mí
    </h1>
    <p class="reveal-item is-visible mt-4 max-w-2xl text-lg leading-relaxed text-(--color-muted)">
      {profile.blurbEs}
    </p>

    <div class="reveal-item is-visible mt-10 rounded-2xl glass-card p-6 sm:p-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-8">
        <div
          class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-(--color-bg) text-(--color-accent) ring-1 ring-(--color-border)"
        >
          <GraduationCap className="h-7 w-7" />
        </div>
        <div class="min-w-0">
          <h2 class="text-lg font-semibold text-(--color-fg)">{profile.fullName}</h2>
          <p class="mt-1 text-sm text-(--color-muted)">{profile.role}</p>
          <ul class="mt-4 flex flex-col gap-2 text-xs text-(--color-muted) sm:flex-row sm:flex-wrap sm:gap-x-5">
            <li class="inline-flex items-center gap-1.5">
              <MapPin className="h-3.5 w-3.5" /> {profile.city}
            </li>
            <li class="inline-flex items-center gap-1.5">
              <Calendar className="h-3.5 w-3.5" /> {profile.education.period}
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-8 space-y-4 border-t border-(--color-border) pt-6 text-base leading-relaxed text-(--color-muted)">
        <p>
          Soy estudiante de {profile.education.degree} en la {profile.education.institution},
          especializado en Inteligencia Artificial. Me interesa construir
          software que combine el rigor de la ingeniería con la capacidad
          expresiva del machine learning: desde sistemas de gestión con
          arquitecturas serias hasta experimentos de deep learning puro.
        </p>
        <p>
          Actualmente me enfoco en tres frentes: Deep Learning aplicado
          (redes neuronales, Transformers, modelos de difusión), desarrollo
          full-stack con Python y JavaScript (Django, React, Astro), y las
          bases matemáticas que sostienen todo lo anterior. Escribo sobre esto
          en mi blog mientras lo aprendo.
        </p>
      </div>

      <ul class="mt-6 flex flex-wrap gap-2">
        {['Deep Learning', 'Transformers', 'Modelos de Difusión', 'Django', 'React', 'Astro', 'PyTorch'].map((area) => (
          <li class="inline-flex items-center gap-1.5 rounded-full border border-(--color-border) bg-(--color-bg) px-3 py-1 text-xs font-semibold text-(--color-fg)">
            <span class="h-1.5 w-1.5 rounded-full bg-(--color-accent)"></span>
            {area}
          </li>
        ))}
      </ul>
    </div>

    <div class="reveal-item is-visible mt-10 grid grid-cols-1 gap-6 sm:grid-cols-3">
      <a
        href={`${base}/proyectos/`}
        class="group rounded-2xl glass-card p-6 transition hover:-translate-y-1"
      >
        <h3 class="text-base font-semibold text-(--color-fg) group-hover:text-(--color-accent)">Proyectos</h3>
        <p class="mt-2 text-sm text-(--color-muted)">Lo que he construido, con contexto y arquitectura.</p>
      </a>
      <a
        href={`${base}/certificaciones/`}
        class="group rounded-2xl glass-card p-6 transition hover:-translate-y-1"
      >
        <h3 class="text-base font-semibold text-(--color-fg) group-hover:text-(--color-accent)">Certificaciones</h3>
        <p class="mt-2 text-sm text-(--color-muted)">Credenciales verificables de mi formación.</p>
      </a>
      <a
        href={`${base}/blog/`}
        class="group rounded-2xl glass-card p-6 transition hover:-translate-y-1"
      >
        <h3 class="text-base font-semibold text-(--color-fg) group-hover:text-(--color-accent)">Blog</h3>
        <p class="mt-2 text-sm text-(--color-muted)">Artículos escritos mientras aprendo.</p>
      </a>
    </div>

    <div class="mt-12">
      <a
        href={`${base}/`}
        class="inline-flex items-center gap-2 rounded-full glass-pill px-5 py-2.5 text-sm font-medium text-(--color-fg) transition hover:-translate-y-0.5 hover:text-(--color-accent)"
      >
        <ArrowLeft className="h-4 w-4" /> Volver al inicio
      </a>
    </div>
  </main>

  <Ticker
    items={['Universidad Tecnológica de México', 'Ciencias de la Computación', '2024 — 2028', 'Deep Learning', 'Full-Stack']}
    duration={26}
    solid
    class="mb-16"
  />
</Layout>