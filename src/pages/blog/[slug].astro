---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Ticker from '../../components/Ticker.astro';
import { ArrowLeft, Calendar, Clock } from 'lucide-react';
import { profile } from '../../data/profile';

// getStaticPaths mapea cada post del blog a /blog/{slug}/ (trailingSlash siempre).
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const p = entry.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = new URL(`${base}/`, Astro.site).toString();
const blogHub = new URL(`${base}/blog/`, Astro.site).toString();
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

const published = p.pubDate.toISOString().slice(0, 10);
const updated = p.updatedDate?.toISOString().slice(0, 10);
const fmtDate = (d: Date) => d.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });

// JSON-LD: BlogPosting + BreadcrumbList (mismo patrón que proyectos/[slug]).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${pageUrl}#blogposting`,
      headline: p.title,
      description: p.summary ?? p.description,
      url: pageUrl,
      author: { '@id': `${homeUrl}#person` },
      publisher: { '@id': `${homeUrl}#website` },
      datePublished: published,
      ...(updated ? { dateModified: updated } : {}),
      inLanguage: 'es',
      keywords: p.tags.join(', '),
      ...(p.coverImage ? { image: new URL(`${base}/${p.coverImage.replace(/^\//, '')}`, Astro.site).toString() } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: homeUrl },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: blogHub },
        { '@type': 'ListItem', position: 3, name: p.title, item: pageUrl },
      ],
    },
  ],
};
---

<Layout
  title={`${p.title} — ${profile.shortName}`}
  description={p.summary ?? p.description}
  ogType="article"
  publishedTime={published}
  modifiedTime={updated}
  articleTags={p.tags}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main id="main" class="mx-auto max-w-4xl px-6 py-32 xl:max-w-5xl">
    <nav aria-label="Migas de pan" class="reveal-item is-visible mb-6">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-(--color-muted)">
        <li><a href={`${base}/`} class="hover:text-(--color-accent)">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`${base}/blog/`} class="hover:text-(--color-accent)">Blog</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-(--color-fg)" aria-current="page">{p.title}</li>
      </ol>
    </nav>

    <article>
      <header class="mb-8">
        <h1 class="reveal-item is-visible font-display text-3xl font-bold tracking-tight text-(--color-fg) sm:text-4xl xl:text-5xl">
          {p.title}
        </h1>
        <p class="reveal-item is-visible mt-4 text-lg leading-relaxed text-(--color-muted)">
          {p.summary ?? p.description}
        </p>
        <div class="reveal-item is-visible mt-5 flex flex-wrap items-center gap-4 text-sm text-(--color-muted)">
          <span class="inline-flex items-center gap-1.5">
            <Calendar className="h-4 w-4" /> {fmtDate(p.pubDate)}
          </span>
          {p.updatedDate && (
            <span class="inline-flex items-center gap-1.5">
              <Clock className="h-4 w-4" /> Actualizado el {fmtDate(p.updatedDate)}
            </span>
          )}
          <span class="text-(--color-fg)">{profile.fullName}</span>
        </div>
      </header>

      {p.coverImage && (
        <img
          src={`${base}/${p.coverImage.replace(/^\//, '')}`}
          alt={`Portada de ${p.title}`}
          width={1600}
          height={1000}
          class="reveal-item is-visible aspect-[8/5] w-full rounded-2xl object-cover"
        />
      )}

      <div class="reveal-item is-visible mt-8 flex flex-wrap gap-2">
        {p.tags.map((t) => (
          <span class="rounded-full bg-(--color-bg) px-2.5 py-1 text-xs font-medium text-(--color-muted) ring-1 ring-(--color-border)">
            {t}
          </span>
        ))}
      </div>

      {/* Cuerpo markdown del post */}
      <div
        class="prose-project reveal-item is-visible mt-10 max-w-none text-base leading-relaxed text-(--color-muted)"
      >
        <Content />
      </div>
    </article>

    <div class="mt-12">
      <a
        href={`${base}/blog/`}
        class="inline-flex items-center gap-2 rounded-full glass-pill px-5 py-2.5 text-sm font-medium text-(--color-fg) transition hover:-translate-y-0.5 hover:text-(--color-accent)"
      >
        <ArrowLeft className="h-4 w-4" /> Ver todos los artículos
      </a>
    </div>
  </main>

  <Ticker
    items={['Deep Learning', 'Transformers', 'Modelos de Difusión', 'PyTorch', 'Django', 'React']}
    duration={32}
    solid
    class="mb-16"
  />
</Layout>